{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp-protocol.org/schema/v0.1.0/rpc/delete-response.json",
  "title": "upp/delete — Response Result",
  "description": "Deletion result with the count of deleted events.",
  "type": "object",
  "required": ["deleted_count"],
  "additionalProperties": false,
  "properties": {
    "deleted_count": {
      "type": "integer",
